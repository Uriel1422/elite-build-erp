# ============================
# EliteBuild ERP - .gitignore
# ============================

# Dependencias de Node
node_modules/
frontend/node_modules/
backend/services/auth-service/node_modules/
backend/services/project-service/node_modules/

# Build producción (se regenera con npm run build)
frontend/dist/
frontend/build/

# Variables de entorno (¡NUNCA subir claves!)
.env
.env.local
.env.production
.env.development
backend/.env
backend/services/**/.env

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Sistemas operativos
.DS_Store
Thumbs.db
desktop.ini

# Editores e IDEs
.vscode/settings.json
.idea/
*.swp
*.swo

# Temporales
*.tmp
*.temp
.cache/

# Docker volúmenes locales
docker-volumes/

# Cobertura de tests
coverage/
.nyc_output/
